import math

#Getting the required input from the user
x1 = int(input("Enter the value for x1: "))
y1 = int(input("Enter the value for y1: "))
x2 = int(input("Enter the value for x2: "))
y2 = int(input("Enter the value for y2: "))

#Processing stage
#Calculating for the distance of the input
result = (pow (x2 - x1, 2)) + (pow (y2 - y1, 2))
distance = math.sqrt(result)

#Displaying the final output
print(f"The distance is {distance:.2f}")

#Reflection - The math library helped me simplify my program by showing me functions like sqrt() and pow() were easier to use. For example in this code, (pow (x2 - x1, 2)) is easier than (x2 - x1) * (x2 - x1) or instead of using sqrt(),I raise the power to 0.5.
